80px) {\n    .ml-rte-table h1,\n    .ml-rte-table p {\n      word-break: normal!important;\n    }\n  }\n  @media only screen and (max-width: 640px) {\n    .mlContentButton a{\n      display: block!important;\n      width: auto!important;\n    }\n  }\n</style><!--{{head_bottom}}--></head>\n\n<body style=\"background-color: #ffffff; padding: 0; margin: 0; -webkit-font-smoothing:antialiased; -webkit-text-size-adjust:none;\"><!--{{body_top}}-->\n\n  \n\n  <table role=\"article\" aria-roledescription=\"email\" aria-label=\"\" align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"680\" style=\"width: 680px; min-width: 680px;\" class=\"mlMainContent\" dir=\"ltr\">\n    <tr>\n      <td class=\"mlTemplateContainer\" style=\"padding: 20px 20px 0px 20px;\">\n\n      \n\n  \n\n  \n\n  \n\n  \n\n  \n    \n    \n    \n    \n    \n    \n  \n\n  \n    \n    \n    \n    \n    \n  \n\n  \n    \n    \n    \n    \n  \n\n  \n    \n    \n  \n\n  \n\n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n  \n\n  \n    \n    \n    \n    \n  \n\n\n\n\n  \n    \n    \n    \n    \n    \n  \n\n  \n    \n    \n    \n  \n\n  \n  \n\n\n\n\n\n\n\n\n\n\n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"\" width=\"100%\" class=\"mlMainContent\">\n        <tr>\n          <td>\n\n            \n  <div class=\"ml-rte-text\">\n    <p style=\"font-family: Helvetica, sans-serif; color: #121212; font-size: 14px; line-height: 125%; margin: 0px 0px 20px 0px;\">Hey {{ first_name }},</p>\n\n  </div>\n\n  <div class=\"ml-rte-text\">\n    <p style=\"font-family: Helvetica, sans-serif; color: #121212; font-size: 14px; line-height: 125%; margin: 0px 0px 20px 0px;\">Welcome to our community! <br><br>Here's how you can get involved in PauseAI UK:<br><br>1. <a href=\"{{verification_link}}\" target=\"_blank\" style=\"color: #1966ff; text-decoration: none;\">Confirm your email address</a> so that we can confirm it’s really you signing up</p>\n\n  </div>\n\n  <div class=\"ml-rte-text\">\n    <p style=\"font-family: Helvetica, sans-serif; color: #121212; font-size: 14px; line-height: 125%; margin: 0px 0px 20px 0px;\">2. Join the <a target=\"_blank\" href=\"https://chat.whatsapp.com/F0nj2RjLNeB1P1hyoDFsTz\" style=\"color: #1966ff; text-decoration: none;\">PauseAI UK WhatsApp community</a> and subscribe to our <a href=\"https://luma.com/pauseai.uk\" target=\"_blank\" style=\"color: #1966ff; text-decoration: none;\">UK events calendar.</a></p>\n\n  </div>\n\n  <div class=\"ml-rte-text\">\n    <p style=\"font-family: Helvetica, sans-serif; color: #121212; font-size: 14px; line-height: 125%; margin: 0px 0px 20px 0px;\">3. If you'd like, <a target=\"_blank\" href=\"https://calendar.app.google/w5t7EgCFwCGKcnAS7\" style=\"color: #1966ff; text-decoration: none;\">book a short call</a> with Joseph, PauseAI UK's director, so he can say hi and introduce you to the community. Looking forward to meeting you,</p>\n\n  </div>\n\n  <div class=\"ml-rte-text\">\n    <p style=\"font-family: Helvetica, sans-serif; color: #121212; font-size: 14px; line-height: 125%; margin: 0px 0px 20px 0px;\"><a target=\"_blank\" href=\"mailto:joseph@pauseai.uk\" style=\"color: #1966ff; text-decoration: none;\">﻿Joseph</a> and <a target=\"_blank\" href=\"mailto:matilda@pauseai.uk\" style=\"color: #1966ff; text-decoration: none;\">Matilda</a>, the PauseAI UK Team</p>\n\n  </div>\n\n  <div class=\"ml-rte-text\">\n    <p style=\"font-family: Helvetica, sans-serif; color: #121212; font-size: 14px; line-height: 125%; margin: 0px 0px 20px 0px;\">PS:  if you have questions, just hit reply.</p>\n\n  </div>\n\n  <div class=\"ml-rte-text\">\n    <p style=\"font-family: Helvetica, sans-serif; color: #121212; font-size: 14px; line-height: 125%; margin: 0px 0px 20px 0px;\"><br></p>\n\n  </div>\n\n  \n\n\n\n\n  \n  \n  \n\n    \n\n  \n  \n  \n  \n  \n  \n  \n  \n\n  \n\n  \n  \n\n  \n\n  <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" width=\"100%\" class